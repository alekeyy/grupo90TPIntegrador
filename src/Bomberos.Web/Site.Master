<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="Bomberos.Web.SiteMaster" %>
<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Bomberos Voluntarios</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/Content/site.css" runat="server" id="lnkSiteCss" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="form1" runat="server">
        <div class="app-shell">
            <!-- Menú lateral (offcanvas en pantallas chicas) -->
            <aside class="offcanvas-lg offcanvas-start app-sidebar" tabindex="-1" id="sidebar">
                <div class="offcanvas-header app-brand">
                    <a runat="server" href="~/Default.aspx" class="app-brand-link"><i class="bi bi-fire"></i> Bomberos Voluntarios</a>
                    <button type="button" class="btn-close btn-close-white d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#sidebar" aria-label="Cerrar"></button>
                </div>
                <div class="offcanvas-body p-0">
                    <nav class="app-nav w-100" aria-label="Menú principal">
                        <a runat="server" href="~/Default.aspx" class="nav-link"><i class="bi bi-house"></i> Inicio</a>

                        <button type="button" class="nav-group" data-bs-toggle="collapse" data-bs-target="#mnu0" aria-expanded="false">
                            <i class="bi bi-people"></i> Personal <i class="bi bi-chevron-down ms-auto chevron"></i>
                        </button>
                        <div class="collapse nav-sub" id="mnu0">
                            <a runat="server" href="~/Personal/Voluntarios.aspx" class="nav-link">Voluntarios</a>
                            <a runat="server" href="~/Personal/Rangos.aspx" class="nav-link">Rangos</a>
                            <a runat="server" href="~/Personal/HistorialRangos.aspx" class="nav-link">Historial de rangos</a>
                            <a runat="server" href="~/Personal/Roles.aspx" class="nav-link">Roles</a>
                            <a runat="server" href="~/Personal/HistorialRoles.aspx" class="nav-link">Historial de roles</a>
                        </div>
                        <button type="button" class="nav-group" data-bs-toggle="collapse" data-bs-target="#mnu1" aria-expanded="false">
                            <i class="bi bi-truck-front"></i> Vehículos <i class="bi bi-chevron-down ms-auto chevron"></i>
                        </button>
                        <div class="collapse nav-sub" id="mnu1">
                            <a runat="server" href="~/Vehiculos/Vehiculos.aspx" class="nav-link">Vehículos</a>
                            <a runat="server" href="~/Vehiculos/TipoVehiculo.aspx" class="nav-link">Tipos de vehículo</a>
                            <a runat="server" href="~/Vehiculos/DocumentacionVehiculo.aspx" class="nav-link">Documentación</a>
                        </div>
                        <button type="button" class="nav-group" data-bs-toggle="collapse" data-bs-target="#mnu2" aria-expanded="false">
                            <i class="bi bi-tools"></i> Equipamiento <i class="bi bi-chevron-down ms-auto chevron"></i>
                        </button>
                        <div class="collapse nav-sub" id="mnu2">
                            <a runat="server" href="~/Equipamiento/Equipamiento.aspx" class="nav-link">Equipamiento</a>
                            <a runat="server" href="~/Equipamiento/TipoEquipamiento.aspx" class="nav-link">Tipos de equipamiento</a>
                            <a runat="server" href="~/Equipamiento/CategoriaEquipamiento.aspx" class="nav-link">Categorías de equipamiento</a>
                        </div>
                        <button type="button" class="nav-group" data-bs-toggle="collapse" data-bs-target="#mnu3" aria-expanded="false">
                            <i class="bi bi-broadcast"></i> Operaciones <i class="bi bi-chevron-down ms-auto chevron"></i>
                        </button>
                        <div class="collapse nav-sub" id="mnu3">
                            <a runat="server" href="~/Operaciones/Incidentes.aspx" class="nav-link">Incidentes</a>
                            <a runat="server" href="~/Operaciones/Misiones.aspx" class="nav-link">Misiones</a>
                            <a runat="server" href="~/Operaciones/TipoMision.aspx" class="nav-link">Tipos de misión</a>
                        </div>
                        <button type="button" class="nav-group" data-bs-toggle="collapse" data-bs-target="#mnu4" aria-expanded="false">
                            <i class="bi bi-mortarboard"></i> Capacitación <i class="bi bi-chevron-down ms-auto chevron"></i>
                        </button>
                        <div class="collapse nav-sub" id="mnu4">
                            <a runat="server" href="~/Capacitacion/Entrenamientos.aspx" class="nav-link">Entrenamientos</a>
                            <a runat="server" href="~/Capacitacion/TipoEntrenamiento.aspx" class="nav-link">Tipos de entrenamiento</a>
                        </div>
                        <a runat="server" href="~/Guardias/Guardias.aspx" class="nav-link"><i class="bi bi-calendar-week"></i> Guardias</a>
                        <button type="button" class="nav-group" data-bs-toggle="collapse" data-bs-target="#mnu6" aria-expanded="false">
                            <i class="bi bi-cash-coin"></i> Finanzas <i class="bi bi-chevron-down ms-auto chevron"></i>
                        </button>
                        <div class="collapse nav-sub" id="mnu6">
                            <a runat="server" href="~/Finanzas/Aportes.aspx" class="nav-link">Aportes</a>
                            <a runat="server" href="~/Finanzas/TipoAporte.aspx" class="nav-link">Tipos de aporte</a>
                            <a runat="server" href="~/Finanzas/Gastos.aspx" class="nav-link">Gastos</a>
                            <a runat="server" href="~/Finanzas/TipoGasto.aspx" class="nav-link">Tipos de gasto</a>
                            <a runat="server" href="~/Finanzas/Caja.aspx" class="nav-link">Cajas</a>
                            <a runat="server" href="~/Finanzas/MovimientoCaja.aspx" class="nav-link">Movimientos de caja</a>
                        </div>
                    </nav>
                </div>
            </aside>

            <!-- Contenido -->
            <div class="app-main">
                <header class="app-topbar">
                    <button type="button" class="btn btn-outline-secondary d-lg-none me-2" data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-label="Abrir menú">
                        <i class="bi bi-list"></i>
                    </button>
                    <span class="fw-semibold">Sistema de Gestión - Cuartel de Bomberos Voluntarios</span>
                </header>
                <main class="app-content">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server" />
                </main>
            </div>
        </div>
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="<%: ResolveUrl("~/Scripts/site.js") %>"></script>
    <asp:ContentPlaceHolder ID="ScriptsContent" runat="server" />
</body>
</html>
