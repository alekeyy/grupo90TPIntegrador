<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="Bomberos.Web.SiteMaster" %>
<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Bomberos Voluntarios</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/Content/site.css" runat="server" id="lnkSiteCss" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="form1" runat="server" class="app-form">
        <div class="app-shell">
            <!-- =========================== MENÚ LATERAL =========================== -->
            <aside class="offcanvas-lg offcanvas-start app-sidebar" tabindex="-1" id="sidebar" aria-labelledby="sidebarTitulo">
                <div class="offcanvas-header app-brand">
                    <a runat="server" href="~/Default.aspx" class="app-brand-link" id="sidebarTitulo">
                        <i class="bi bi-fire"></i>
                        <span>Bomberos<small>Voluntarios</small></span>
                    </a>
                    <button type="button" class="btn-close btn-close-white d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#sidebar" aria-label="Cerrar"></button>
                </div>
                <div class="offcanvas-body p-0">
                    <nav class="app-nav w-100" aria-label="Menú principal">
                        <a runat="server" href="~/Default.aspx" class="nav-link"><i class="bi bi-speedometer2"></i> Dashboard</a>

                        <button type="button" class="nav-group" data-bs-toggle="collapse" data-bs-target="#mnuPersonal" aria-expanded="false">
                            <i class="bi bi-people"></i> Personal <i class="bi bi-chevron-down ms-auto chevron"></i>
                        </button>
                        <div class="collapse nav-sub" id="mnuPersonal">
                            <a runat="server" href="~/Personal/Voluntarios.aspx" class="nav-link">Voluntarios</a>
                            <a runat="server" href="~/Catalogos/Catalogo.aspx?tipo=Rangos" class="nav-link">Rangos</a>
                            <a runat="server" href="~/Personal/HistorialRangos.aspx" class="nav-link">Historial de rangos</a>
                            <a runat="server" href="~/Catalogos/Catalogo.aspx?tipo=Roles" class="nav-link">Roles</a>
                            <a runat="server" href="~/Personal/HistorialRoles.aspx" class="nav-link">Historial de roles</a>
                        </div>

                        <button type="button" class="nav-group" data-bs-toggle="collapse" data-bs-target="#mnuVehiculos" aria-expanded="false">
                            <i class="bi bi-truck-front"></i> Vehículos <i class="bi bi-chevron-down ms-auto chevron"></i>
                        </button>
                        <div class="collapse nav-sub" id="mnuVehiculos">
                            <a runat="server" href="~/Vehiculos/Vehiculos.aspx" class="nav-link">Vehículos</a>
                            <a runat="server" href="~/Catalogos/Catalogo.aspx?tipo=TipoVehiculo" class="nav-link">Tipos de vehículo</a>
                            <a runat="server" href="~/Vehiculos/Documentacion.aspx" class="nav-link">Documentación</a>
                        </div>

                        <button type="button" class="nav-group" data-bs-toggle="collapse" data-bs-target="#mnuEquipamiento" aria-expanded="false">
                            <i class="bi bi-tools"></i> Equipamiento <i class="bi bi-chevron-down ms-auto chevron"></i>
                        </button>
                        <div class="collapse nav-sub" id="mnuEquipamiento">
                            <a runat="server" href="~/Equipamiento/Equipamiento.aspx" class="nav-link">Equipamiento</a>
                            <a runat="server" href="~/Catalogos/Catalogo.aspx?tipo=TipoEquipamiento" class="nav-link">Tipos de equipamiento</a>
                            <a runat="server" href="~/Catalogos/Catalogo.aspx?tipo=CategoriaEquipamiento" class="nav-link">Categorías</a>
                        </div>

                        <button type="button" class="nav-group" data-bs-toggle="collapse" data-bs-target="#mnuOperaciones" aria-expanded="false">
                            <i class="bi bi-broadcast"></i> Operaciones <i class="bi bi-chevron-down ms-auto chevron"></i>
                        </button>
                        <div class="collapse nav-sub" id="mnuOperaciones">
                            <a runat="server" href="~/Operaciones/Incidentes.aspx" class="nav-link">Incidentes</a>
                            <a runat="server" href="~/Operaciones/Misiones.aspx" class="nav-link">Misiones</a>
                            <a runat="server" href="~/Catalogos/Catalogo.aspx?tipo=TipoMision" class="nav-link">Tipos de misión</a>
                        </div>

                        <button type="button" class="nav-group" data-bs-toggle="collapse" data-bs-target="#mnuCapacitacion" aria-expanded="false">
                            <i class="bi bi-mortarboard"></i> Capacitación <i class="bi bi-chevron-down ms-auto chevron"></i>
                        </button>
                        <div class="collapse nav-sub" id="mnuCapacitacion">
                            <a runat="server" href="~/Capacitacion/Entrenamientos.aspx" class="nav-link">Entrenamientos</a>
                            <a runat="server" href="~/Catalogos/Catalogo.aspx?tipo=TipoEntrenamiento" class="nav-link">Tipos de entrenamiento</a>
                        </div>

                        <a runat="server" href="~/Guardias/Guardias.aspx" class="nav-link"><i class="bi bi-calendar-week"></i> Guardias</a>

                        <button type="button" class="nav-group" data-bs-toggle="collapse" data-bs-target="#mnuFinanzas" aria-expanded="false">
                            <i class="bi bi-cash-coin"></i> Finanzas <i class="bi bi-chevron-down ms-auto chevron"></i>
                        </button>
                        <div class="collapse nav-sub" id="mnuFinanzas">
                            <a runat="server" href="~/Finanzas/Aportes.aspx" class="nav-link">Aportes</a>
                            <a runat="server" href="~/Catalogos/Catalogo.aspx?tipo=TipoAporte" class="nav-link">Tipos de aporte</a>
                            <a runat="server" href="~/Finanzas/Gastos.aspx" class="nav-link">Gastos</a>
                            <a runat="server" href="~/Catalogos/Catalogo.aspx?tipo=TipoGasto" class="nav-link">Tipos de gasto</a>
                            <a runat="server" href="~/Catalogos/Catalogo.aspx?tipo=Caja" class="nav-link">Cajas</a>
                            <a runat="server" href="~/Finanzas/MovimientosCaja.aspx" class="nav-link">Movimientos de caja</a>
                        </div>

                        <button type="button" class="nav-group" data-bs-toggle="collapse" data-bs-target="#mnuReportes" aria-expanded="false">
                            <i class="bi bi-file-earmark-bar-graph"></i> Reportes <i class="bi bi-chevron-down ms-auto chevron"></i>
                        </button>
                        <div class="collapse nav-sub" id="mnuReportes">
                            <a runat="server" href="~/Reportes/Reportes.aspx?cat=personal" class="nav-link">Personal</a>
                            <a runat="server" href="~/Reportes/Reportes.aspx?cat=operaciones" class="nav-link">Operaciones</a>
                            <a runat="server" href="~/Reportes/Reportes.aspx?cat=vehiculos" class="nav-link">Vehículos</a>
                            <a runat="server" href="~/Reportes/Reportes.aspx?cat=equipamiento" class="nav-link">Equipamiento</a>
                            <a runat="server" href="~/Reportes/Reportes.aspx?cat=finanzas" class="nav-link">Finanzas</a>
                        </div>
                    </nav>
                </div>
            </aside>

            <!-- =========================== CONTENIDO =========================== -->
            <div class="app-main">
                <header class="app-topbar">
                    <button type="button" class="btn btn-outline-secondary d-lg-none me-2" data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-controls="sidebar" aria-label="Abrir menú">
                        <i class="bi bi-list"></i>
                    </button>
                    <span class="app-topbar-title"><asp:Literal ID="litCuartel" runat="server" /></span>
                    <span class="ms-auto text-muted small d-none d-sm-inline"><i class="bi bi-calendar3"></i> <asp:Literal ID="litFecha" runat="server" /></span>
                </header>

                <main class="app-content">
                    <asp:PlaceHolder ID="phMensajes" runat="server" />
                    <asp:ContentPlaceHolder ID="MainContent" runat="server" />
                </main>

                <footer class="app-footer">
                    Sistema de Gestión de Cuartel de Bomberos Voluntarios &middot; Grupo 90 &middot; <asp:Literal ID="litAnio" runat="server" />
                </footer>
            </div>
        </div>
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="<%: ResolveUrl("~/Scripts/site.js") %>"></script>
    <asp:ContentPlaceHolder ID="ScriptsContent" runat="server" />
</body>
</html>
