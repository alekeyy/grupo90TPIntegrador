<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuración de la aplicación web - Sistema de Gestión de Bomberos Voluntarios.
  IMPORTANTE: ajustar "Data Source" de la cadena DBBomberos según la instancia de SQL Server.
    - SQL Server Express:  Data Source=.\SQLEXPRESS
    - LocalDB:             Data Source=(localdb)\MSSQLLocalDB
    - Instancia por defecto: Data Source=localhost
-->
<configuration>
  <connectionStrings>
    <add name="DBBomberos"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=DB_Bomberos;Integrated Security=True;MultipleActiveResultSets=False;Connect Timeout=15"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- Validadores ASP.NET con JavaScript clásico (no requiere jQuery) -->
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
    <add key="NombreCuartel" value="Bomberos Voluntarios" />
    <!-- Cantidad de filas por página en las grillas -->
    <add key="FilasPorPagina" value="10" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="4096" enableVersionHeader="false" />
    <globalization culture="es-AR" uiCulture="es-AR" requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" />
    <!-- RemoteOnly: los usuarios remotos ven Error.aspx; en el servidor local se ve el detalle del error -->
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error.aspx">
      <error statusCode="404" redirect="~/Error.aspx?codigo=404" />
    </customErrors>
    <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="Predictable" validateRequest="true" />
  </system.web>

  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
