<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- Ajustar "Data Source" según la instancia de SQL Server (.\SQLEXPRESS, (localdb)\MSSQLLocalDB, localhost) -->
    <add name="DBBomberos"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=DB_Bomberos;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <globalization culture="es-AR" uiCulture="es-AR" />
  </system.web>
</configuration>
